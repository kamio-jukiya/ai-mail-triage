# ===== 必須 =====
# Anthropic APIキー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ===== 任意（未設定なら既定値を使う）=====
# 分類に使うモデル
TRIAGE_MODEL=claude-opus-5

# 1回の実行で処理する上限。無限に走らせないための安全弁
TRIAGE_MAX_MESSAGES=20

# 分類の確信度がこの値を下回ったら「保留」に落とす（0.0〜1.0）
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# 処理済みメッセージIDの保存先。再実行時の二重処理を防ぐために使う
TRIAGE_STATE_PATH=state/processed.json

# ログにメールの内容（件名・差出人・要約）を含めるか。
# 公開リポジトリの GitHub Actions 実行ログは誰でも読めるため既定は false。
# デモ実行時のみ既定で true になる
TRIAGE_LOG_CONTENT=false

# ===== Gmail / Google Sheets を使う場合 =====
# 認証方式は自動判定される。両方の設定がある場合だけ明示する
# service_account = Google Workspace / oauth = 個人の @gmail.com
GOOGLE_AUTH_MODE=

# --- 方式A: Google Workspace（サービスアカウント + ドメイン全体の委任）---
# サービスアカウントのJSONキー（1行に圧縮したもの）
GOOGLE_SERVICE_ACCOUNT_JSON=
# 委任先のGmailアドレス。方式Aでのみ使う
GMAIL_USER=you@example.com

# --- 方式B: 個人の @gmail.com（OAuth）---
# 個人アカウントにはドメイン全体の委任が存在しないため、方式Aは使えない。
# リフレッシュトークンは `npm run auth:google` で取得する。
# 注意: OAuth同意画面が「テスト」状態のまま取得したトークンは7日で失効する
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 取得条件。Gmailの検索構文がそのまま使える
GMAIL_QUERY=is:unread -category:promotions
# 記録先スプレッドシートのID（URLの /d/ と /edit の間）
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=triage!A:H

# ===== 通知（任意）=====
SLACK_WEBHOOK_URL=
